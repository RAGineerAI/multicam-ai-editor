# ==============================================================================
# Шаблон .env для multicam-ai-editor.
#
# Скопируй в .env и заполни:
#   cp .env.example .env
#
# .env НЕ коммитится (см. .gitignore) — там секреты (HF_TOKEN).
# ==============================================================================

# Папки
UPLOAD_DIR=uploads
OUTPUT_DIR=output
MODELS_DIR=models

# Redis (Celery, v0.9)
REDIS_URL=redis://localhost:6379/0

# Whisper (v0.6)
WHISPER_MODEL=small
WHISPER_DEVICE=cuda

# Hugging Face (для скачивания моделей pyannote/Whisper)
# Токен: https://huggingface.co/settings/tokens
# После первого скачивания моделей можно поставить HF_HUB_OFFLINE=1
HF_TOKEN=your-token-here
HF_HUB_OFFLINE=0

# Диаризация (v0.3)
# Короткие файлы (< DIARIZATION_LONG_THRESHOLD_SEC) → pyannote 3.1
# Длинные (>= порога) → pyannote community-1 (лучше на длинных записях)
DIARIZATION_MODEL_SHORT=pyannote/speaker-diarization-3.1
DIARIZATION_MODEL_LONG=pyannote/speaker-diarization-community-1
DIARIZATION_LONG_THRESHOLD_SEC=1800
DIARIZATION_DEVICE=auto
MIN_SEGMENT_DURATION_SEC=1.0

# Кэш (v0.3)
CACHE_DIR=output/cache

# Отладка
DEBUG=false